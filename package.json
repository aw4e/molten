{
  "name": "molten-mcp",
  "version": "0.2.0",
  "description": "Molten — AI-powered MCP DevTools for Mantle Network. Contract audit, gas optimization, tx simulation, wallet intelligence, and explorer integration.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "molten": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mantle",
    "mcp",
    "model-context-protocol",
    "solidity",
    "audit",
    "gas-optimization",
    "web3",
    "blockchain",
    "ai",
    "devtools"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "deploy:sepolia": "tsx demo/deploy/deploy.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^17.4.2",
    "openai": "^4.77.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
