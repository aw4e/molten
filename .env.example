# ── AI Provider ───────────────────────────────────────────────────────────────
# Choose one: anthropic | openai | gemini | tencent-hunyuan | mimo (default: anthropic)
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-pro

# Tencent Hunyuan (Track 05 sponsor — https://hunyuan.tencent.com)
TENCENT_HUNYUAN_API_KEY=...
TENCENT_HUNYUAN_MODEL=hunyuan-pro

# MiMo (Xiaomi — https://token-plan-sgp.xiaomimimo.com/v1)
MIMO_API_KEY=...
MIMO_MODEL=mimo-v2.5-pro

# ── Mantle RPC ─────────────────────────────────────────────────────────────────
MANTLE_RPC_URL=https://rpc.mantle.xyz
MANTLE_SEPOLIA_RPC_URL=https://rpc.sepolia.mantle.xyz

# ── Nansen AI (onchain wallet intelligence) ────────────────────────────────────
# Get credits at https://app.nansen.ai — $7,000 available for hackathon teams
NANSEN_API_KEY=...

# ── Mantle Explorer ────────────────────────────────────────────────────────────
# Optional — public API works without key, key increases rate limits
# Mainnet: https://explorer.mantle.xyz | Sepolia: https://explorer.sepolia.mantle.xyz
MANTLE_EXPLORER_API_KEY=
